{
  "name": "dsh-plugin-doctor",
  "version": "0.1.0",
  "description": "Read-only audit of a DeepSeek Harness plugin repository against the dsh-plugin listing rules: dsh.bundle manifest, bundle patch rows, prerelease-safe @deepseek-ai/dsh peer ranges, shipped implementation files, repository age, description, and the dsh-plugin GitHub topic. Runs as the plugin_doctor tool and as a CLI.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "dsh-plugin-doctor": "bin/dsh-plugin-doctor.mjs"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "audit",
    "lint",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tim-ReJet/dsh-plugin-doctor.git"
  },
  "homepage": "https://github.com/Tim-ReJet/dsh-plugin-doctor#readme",
  "bugs": {
    "url": "https://github.com/Tim-ReJet/dsh-plugin-doctor/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "doctor": "node bin/dsh-plugin-doctor.mjs .",
    "doctor:topic": "node bin/dsh-plugin-doctor.mjs . --network",
    "entry": "node bin/dsh-plugin-doctor.mjs . --emit-entry"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.1.2-0 || >=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
